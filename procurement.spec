        'gui.views.comparison_page',
        'gui.views.email_page',
        'gui.views.history_page',
        'gui.components',
        'gui.components.status_badge',
        'gui.components.data_table',
        'gui.components.file_drop_zone',
        'gui.viewmodels',
        'gui.viewmodels.file_upload_vm',
        'gui.viewmodels.parsed_data_vm',
        'gui.viewmodels.orders_vm',
        'gui.viewmodels.comparison_vm',
        'gui.viewmodels.email_vm',
        'gui.viewmodels.history_vm',
        'gui.services',
        'gui.services.backend_interface',
        'main',
        'models',
        'parsers',
        'parsers.xlsx_parser',
        'parsers.pdf_parser',
