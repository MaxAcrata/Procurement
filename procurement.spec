    ['build_entry.py'],
    pathex=[],
    binaries=[],
    datas=[
        ('emails_db.json', '.'),
    ] + collect_data_files('pandas', excludes=['pandas.tests']),
    hiddenimports=[
        # Internal project modules
        'gui_app',
        'gui.main_window',
        'gui.styles.dark_theme',
        'gui.views',
        'gui.views.file_upload_page',
        'gui.views.parsed_data_page',
